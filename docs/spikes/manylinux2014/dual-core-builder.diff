diff --git a/builder/dual-mm-modern.sh b/builder/dual-mm-modern.sh
new file mode 100755
index 0000000..f4e4c1d
--- /dev/null
+++ b/builder/dual-mm-modern.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+# css34 dual SM 1.11 build: prepare the Metamod 1.12 tree whose headers the
+# 2.ep1 core / *.ext.2.ep1 / shared extensions / logic / loader / DHooks are
+# compiled against (PLAPI 16, SourceHook v5). The 1.ep1 targets keep using the
+# css34-patched MM 1.10 legacy headers (CSS34_MMS_LEGACY_ROOT).
+#
+# Optionally (CSS34_DUAL_BUILD_MM112=1) also builds + packages that Metamod 1.12
+# so the SM package can be smoke-tested on both Metamods from one run.
+#
+# Prints the Metamod 1.12 directory on stdout (last line).
+set -euo pipefail
+
+DEPS_DIR="${DEPS_DIR:?}"
+BUILDER_DIR="${BUILDER_DIR:?}"
+WDIR="${WDIR:?}"
+PACKAGES_DIR="${PACKAGES_DIR:?}"
+MODERN_COMMIT="${CSS34_DUAL_MM_COMMIT:?}"
+MODERN_REV="${CSS34_DUAL_MM_REV:?}"
+MODERN_DIR="$DEPS_DIR/${CSS34_DUAL_MM_DIRNAME:-mmsource-1.12}"
+url="https://github.com/alliedmodders/metamod-source"
+
+{
+  echo "==> css34 dual: Metamod 1.12 headers for 2.ep1 targets ($MODERN_COMMIT, git$MODERN_REV)"
+  if [ ! -d "$MODERN_DIR/.git" ]; then
+    git clone --depth 1 "$url" "$MODERN_DIR"
+  fi
+  git -C "$MODERN_DIR" fetch --depth 1 origin "$MODERN_COMMIT"
+  git -C "$MODERN_DIR" checkout --force "$MODERN_COMMIT"
+  git -C "$MODERN_DIR" clean -fdxq -e hl2sdk-manifests
+  git -C "$MODERN_DIR" submodule update --init --recursive
+  bash "$BUILDER_DIR/patches/apply-mmsource-v112.sh" "$MODERN_DIR"
+  # Stamp only the MM tree (SOURCEMOD_DIR pointed nowhere on purpose).
+  WDIR="$WDIR" SOURCEMOD_DIR=/nonexistent MMS_DIR="$MODERN_DIR" MMS_COMMIT="$MODERN_COMMIT" \
+    bash "$BUILDER_DIR/write-build-stamps.sh"
+
+  for f in core/ISmmPluginExt.h core/sourcehook/sourcehook.h core/sourcehook/sourcehook_hookmangen.h; do
+    [ -f "$MODERN_DIR/$f" ] || { echo "css34 dual: missing $MODERN_DIR/$f" >&2; exit 1; }
+  done
+  grep -q 'SH_IFACE_VERSION 5' "$MODERN_DIR/core/sourcehook/sourcehook.h" \
+    || { echo "css34 dual: Metamod 1.12 sourcehook.h is not SH v5" >&2; exit 1; }
+
+  if [ "${CSS34_DUAL_BUILD_MM112:-0}" = "1" ]; then
+    echo "==> css34 dual: building Metamod 1.12 package (metamod.2.ep1)"
+    WDIR="$WDIR" DEPS_DIR="$DEPS_DIR" BUILDER_DIR="$BUILDER_DIR" \
+      CC="$CC" CXX="$CXX" USE_CLANG9="${USE_CLANG9:-0}" \
+      SOURCEMOD_MAJOR=12 MMS_DIR="$MODERN_DIR" MMS_MODE=1.12 \
+      MMS_DIRNAME="$(basename "$MODERN_DIR")" \
+      bash "$BUILDER_DIR/build-metamod.sh"
+    art="$(MMS_COMMIT="$MODERN_COMMIT" MMS_GIT_REV="$MODERN_REV" bash "$BUILDER_DIR/package-metamod.sh" \
+      "$MODERN_DIR/build/package" "$PACKAGES_DIR" "$MODERN_DIR")"
+    echo "==> css34 dual: Metamod 1.12 package: $art"
+  fi
+} >&2
+
+echo "$MODERN_DIR"
