# Pinned MSVC x86 toolset and Windows SDK for windows-2022.
# .github/actions/build-windows (ci.yml and release.yml) reads these and passes them to ilammy/msvc-dev-cmd
# (vcvarsall.bat x86 <sdk> -vcvars_ver=<toolset>). windows.sh records the
# full versions vcvars resolves (VCToolsVersion, WindowsSDKVersion) in
# css34-package.json.
MSVC_TOOLSET_PREFIX=14.44
WINDOWS_SDK_PIN=10.0.26100.0
