+#if SOURCE_ENGINE == SE_CSGO
+using HandleBuyHook = KHook::Member<CCSPlayerDetour, int, int, void *, bool, bool>;
+#else
+using HandleBuyHook = KHook::Member<CCSPlayerDetour, int, const char *>;
+using WeaponPriceHook = KHook::Member<CCSWeaponInfoDetour, int>;
+#endif
+#if SOURCE_ENGINE == SE_CSS || SOURCE_ENGINE == SE_EPISODEONE
+using TerminateRoundHook = KHook::Member<CCSGameRulesDetour, void, float, int>;
