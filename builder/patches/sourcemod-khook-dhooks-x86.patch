+#include "../sp_inc.hpp"
+#include "../capsule.hpp"
+#include "../sdk_types.hpp"
+
+#include <cstdlib>
+#include <vector>
+#include <optional>
+
+// 32-bit x86, as used by 32-bit Source engine games.
+//
+// Linux: i386 System V (GCC / Clang).
+// Reference: https://www.uclibc.org/docs/psABI-i386.pdf
+// - Every parameter lives on the stack, including `this` for member functions
+//   (CallConv_THISCALL). CallConv_FASTCALL passes the first two 32-bit
+//   integer parameters in ECX / EDX.
+// - Integer and pointer values are returned in EAX, float in x87 ST(0).
+// - Vector and string_t are returned through a hidden pointer pushed before
+//   every other argument; the callee pops it (`ret 4`) and returns it in EAX.
+// - CallConv_STDCALL / CallConv_FASTCALL functions pop their own stack
+//   arguments.
+//
+// Windows: MSVC.
+// Reference: https://learn.microsoft.com/cpp/cpp/argument-passing-and-naming-conventions
+// - CallConv_THISCALL passes `this` in ECX, the other parameters on the stack,
+//   and the callee pops them. CallConv_FASTCALL passes the first two 32-bit
+//   integer parameters in ECX / EDX.
+// - Integer and pointer values are returned in EAX, float in x87 ST(0).
+// - Vector (user constructors) and string_t (protected member) are never
+//   returned in registers: the hidden pointer is the first stack argument
+//   (after `this` in ECX), the callee returns it in EAX, and it is popped with
+//   the other arguments (callee for THISCALL / STDCALL, caller for CDECL).
+//
+// KHook enters the PRE / POST / call-original stubs with `retn`: the return
+// address back into the detour is on top of the stack, followed by a copy of
+// the stack arguments, and the general registers hold their values from the
+// function entry. make_return runs in place of the hooked function, so it must
+// leave the return value in EAX / ST(0) and pop what the callee pops.
+
+namespace dhooks::abi {
+
+using namespace KHook::Asm;
+
+namespace {
+
+// Not VOID: winnt.h defines it as a macro
+enum class RetClass {
+	Void,
+	Integer,
+	X87Float,
+	Memory
+};
+
+std::optional<RetClass> Classify_ReturnType(const ReturnVariable& info) {
+	switch (info.dhook_type) {
+	case sp::ReturnType_Int:
+	case sp::ReturnType_Bool:
+	case sp::ReturnType_StringPtr:
+	case sp::ReturnType_CharPtr:
+	case sp::ReturnType_VectorPtr:
+	case sp::ReturnType_CBaseEntity:
+	case sp::ReturnType_Edict:
+		return RetClass::Integer;
+	case sp::ReturnType_Float:
+		return RetClass::X87Float;
+	case sp::ReturnType_String:
+	case sp::ReturnType_Vector:
+		return RetClass::Memory;
+	case sp::ReturnType_Void:
+		return RetClass::Void;
+	default:
+		break;
+	}
+	return {};
+}
+
+// Size of a parameter passed by value on the stack, 0 when unsupported
+std::size_t StackSlotSize(const Variable& param) {
+	if (param.dhook_pass_flags & sp::DHookPass_ByRef) {
+		return sizeof(void*);
+	}
+	switch (param.dhook_type) {
+	case sp::HookParamType_Int:
+	case sp::HookParamType_Bool:
+	case sp::HookParamType_Float:
+	case sp::HookParamType_String:
+	case sp::HookParamType_StringPtr:
+	case sp::HookParamType_CharPtr:
+	case sp::HookParamType_VectorPtr:
+	case sp::HookParamType_CBaseEntity:
+	case sp::HookParamType_ObjectPtr:
+	case sp::HookParamType_Edict:
+		return sizeof(void*);
+	case sp::HookParamType_Object:
+		return (param.dhook_size + 3) & ~static_cast<std::size_t>(3);
+	default:
+		break;
+	}
+	return 0;
+}
+
+bool IsIntegerRegisterParam(const Variable& param) {
+	if (param.dhook_pass_flags & sp::DHookPass_ByRef) {
+		return true;
+	}
+	switch (param.dhook_type) {
+	case sp::HookParamType_Int:
+	case sp::HookParamType_Bool:
+	case sp::HookParamType_StringPtr:
+	case sp::HookParamType_CharPtr:
+	case sp::HookParamType_VectorPtr:
+	case sp::HookParamType_CBaseEntity:
+	case sp::HookParamType_ObjectPtr:
+	case sp::HookParamType_Edict:
+		return true;
+	default:
+		break;
+	}
+	return false;
+}
+
+// Encodings the KHook x86 assembler does not provide
+void Emit_Fld32(AsmJit& jit, x86_RegRm rm) {
+	jit.write_ubyte(0xD9); // FLD m32fp
+	rm.write_modrm(&jit, static_cast<x86Reg>(0));
+}
+
+void Emit_Fstp32(AsmJit& jit, x86_RegRm rm) {
+	jit.write_ubyte(0xD9); // FSTP m32fp
+	rm.write_modrm(&jit, static_cast<x86Reg>(3));
+}
+
+void Emit_MovsdStore(AsmJit& jit, x86_RegRm rm, AsmFloatRegCode reg) {
+	jit.write_ubyte(0xF2); // MOVSD m64, xmm
+	jit.write_ubyte(0x0F);
+	jit.write_ubyte(0x11);
+	rm.write_modrm(&jit, static_cast<x86Reg>(reg & 0x7));
+}
+
+void Emit_MovsdLoad(AsmJit& jit, AsmFloatRegCode reg, x86_RegRm rm) {
+	jit.write_ubyte(0xF2); // MOVSD xmm, m64
+	jit.write_ubyte(0x0F);
+	jit.write_ubyte(0x10);
+	rm.write_modrm(&jit, static_cast<x86Reg>(reg & 0x7));
+}
+
+void Emit_Ret(AsmJit& jit, std::size_t pop) {
+	if (pop == 0) {
+		jit.retn();
+		return;
+	}
+	jit.write_ubyte(0xC2); // RET imm16
+	jit.write_ushort(static_cast<unsigned short>(pop));
+}
+
+// Copy `size` bytes (multiple of 4) from [src + src_off] to [dst + dst_off] through `tmp`
+void Emit_CopyDwords(AsmJit& jit, x86_Reg dst, std::int32_t dst_off, x86_Reg src, std::int32_t src_off, std::size_t size, x86_Reg tmp) {
+	for (std::size_t i = 0; i < size; i += sizeof(std::uint32_t)) {
+		jit.mov(tmp, src(src_off + static_cast<std::int32_t>(i)));
+		jit.mov(dst(dst_off + static_cast<std::int32_t>(i)), tmp);
+	}
+}
+
+constexpr std::int32_t kAlign16 = -16;
+
+} // namespace
+
+bool Proccess(sp::CallingConvention conv, std::vector<Variable>& params, ReturnVariable& ret, size_t& stack_size) {
+	if (conv != sp::CallConv_CDECL && conv != sp::CallConv_THISCALL
+	&& conv != sp::CallConv_STDCALL && conv != sp::CallConv_FASTCALL) {
+		globals::sourcemod->LogError(globals::myself, "Unsupported calling convention (%d)!", conv);
+		return false;
+	}
+
+	if (ret.dhook_custom_register != sp::DHookRegister_Default) {
+		globals::sourcemod->LogError(globals::myself, "Custom register for return isn't supported!");
+		return false;
+	}
+
+	auto cls = Classify_ReturnType(ret);
+	if (!cls.has_value()) {
+		globals::sourcemod->LogError(globals::myself, "Couldn't classify return type!");
+		return false;
+	}
+
+#if defined(_WIN32)
+	if (conv == sp::CallConv_FASTCALL && cls.value() == RetClass::Memory) {
+		// MSVC passes the hidden return pointer in ECX there
+		globals::sourcemod->LogError(globals::myself, "FASTCALL functions returning Vector / string_t aren't supported!");
+		return false;
+	}
+#endif
+
+	/* Skip the return address */
+	size_t stack_offset = sizeof(void*);
+	ret.callee_pop = 0;
+	if (cls.value() == RetClass::Memory) {
+		if (ret.dhook_size == 0 || (ret.dhook_size % sizeof(std::uint32_t)) != 0) {
+			globals::sourcemod->LogError(globals::myself, "Unsupported size (%zu) for a return value passed in memory!", ret.dhook_size);
+			return false;
+		}
+		// Hidden return pointer, pushed before any other argument
+		ret.reg_index = ESP;
+		ret.reg_offset = stack_offset;
+		stack_offset += sizeof(void*);
+	}
+
+	// Linux member functions take `this` as their first stack argument, MSVC ones in ECX
+	if (conv == sp::CallConv_THISCALL) {
+		Variable this_ptr;
+		this_ptr.dhook_type = sp::HookParamType_Int;
+#if defined(_WIN32)
+		this_ptr.dhook_custom_register = sp::DHookRegister_ECX;
+#else
+		this_ptr.dhook_custom_register = sp::DHookRegister_Default;
+#endif
+		this_ptr.dhook_pass_flags = sp::DHookPass_ByVal;
+		this_ptr.dhook_size = sizeof(void*);
+		params.insert(params.begin(), this_ptr);
+	}
+
+	static const x86_Reg fastcall_registers[] = { ecx, edx };
+	size_t fastcall_used = 0;
+
+	{auto len = params.size(); for (unsigned int i = 0; i < len; i++) {
+		auto& param = params[i];
+		if (param.dhook_custom_register != sp::DHookRegister_Default) {
+			param.reg_index = Translate_DHookRegister(param.dhook_custom_register);
+			param.float_reg_index = Translate_DHookRegister_Float(param.dhook_custom_register);
+			param.reg_offset = {};
+			if (!param.reg_index && !param.float_reg_index) {
+				globals::sourcemod->LogError(globals::myself, "Unsupported custom register for parameter (%d)!", i);
+				return false;
+			}
+			if (param.reg_index && (param.reg_index.value() == ESP || param.reg_index.value() == EBP)) {
+				globals::sourcemod->LogError(globals::myself, "ESP / EBP can't hold parameter (%d)!", i);
+				return false;
+			}
+			continue;
+		}
+
+		if (conv == sp::CallConv_FASTCALL && fastcall_used < std::size(fastcall_registers) && IsIntegerRegisterParam(param)) {
+			param.reg_index = fastcall_registers[fastcall_used++];
+			param.reg_offset = {};
+			continue;
+		}
+
+		auto slot = StackSlotSize(param);
+		if (slot == 0) {
+			globals::sourcemod->LogError(globals::myself, "ABI could not classify parameter (%d)!", i);
+			return false;
+		}
+		param.reg_index = ESP;
+		param.reg_offset = stack_offset;
+		stack_offset += slot;
+	}}
+
+	/* Stack size here only means the size the parameters occupy, so remove the space occupied by return address */
+	stack_size = stack_offset - sizeof(void*);
+	if (conv == sp::CallConv_STDCALL || conv == sp::CallConv_FASTCALL) {
+		ret.callee_pop = stack_size;
+	}
+#if defined(_WIN32)
+	else if (conv == sp::CallConv_THISCALL) {
+		ret.callee_pop = stack_size;
+	}
+#else
+	else if (cls.value() == RetClass::Memory) {
+		ret.callee_pop = sizeof(void*);
+	}
+#endif
+	return true;
+}
+
+void JIT_CallMemberFunction(AsmJit& jit, bool save_general_register[MAX_GENERAL_REGISTERS], bool save_float_register[MAX_FLOAT_REGISTERS], void* this_ptr, const void* mfp, bool post) {
+	// [ebp + 4] is the return address back into KHook, arguments follow
+	jit.push(ebp);
+	jit.mov(ebp, esp);
+	jit.l_and(esp, kAlign16);
+
+	static constexpr std::int32_t args_size = 0x10;
+	static constexpr std::int32_t regs_size = (MAX_GENERAL_REGISTERS * sizeof(GeneralRegister)) + (MAX_FLOAT_REGISTERS * sizeof(FloatRegister));
+	static_assert(regs_size % 16 == 0);
+	jit.sub(esp, args_size + regs_size);
+
+	// Save every general register, not only the ones holding parameters: on a
+	// recall KHook copies the registers it is re-entered with over the ones it
+	// saved at the original entry, and restores those (EBX, ESI and EDI
+	// included) when it finally returns to the caller.
+	jit.mov(esp(args_size), eax);
+	for (size_t i = 1; i < MAX_GENERAL_REGISTERS; i++) {
+		auto offset = args_size + static_cast<std::int32_t>(i * sizeof(GeneralRegister));
+		auto reg = AsmReg((AsmRegCode)i);
+		if (reg == STACK_REG) {
+			// Value of ESP when KHook entered us
+			jit.lea(eax, ebp(sizeof(void*)));
+			jit.mov(esp(offset), eax);
+		} else if (reg == ebp) {
+			jit.mov(eax, ebp());
+			jit.mov(esp(offset), eax);
+		} else {
+			jit.mov(esp(offset), reg);
+		}
+	}
+
+	for (size_t i = 0; i < MAX_FLOAT_REGISTERS; i++) {
+		if (!save_float_register[i]) {
+			continue;
+		}
+		Emit_MovsdStore(jit, esp(args_size + static_cast<std::int32_t>(MAX_GENERAL_REGISTERS * sizeof(GeneralRegister) + i * sizeof(FloatRegister))), (AsmFloatRegCode)i);
+	}
+
+	// void Capsule::PrePostHookLoop(std::uint8_t* saved_register, bool post)
+#if defined(_WIN32)
+	// __thiscall: `this` in ECX, the callee pops its arguments (ESP is restored from EBP below)
+	jit.mov(ecx, reinterpret_cast<std::uintptr_t>(this_ptr));
+	jit.lea(eax, esp(args_size));
+	jit.mov(esp(0x0), eax);
+	jit.mov(esp(0x4), post ? 1 : 0);
+#else
+	jit.mov(esp(0x0), reinterpret_cast<std::uintptr_t>(this_ptr));
+	jit.lea(eax, esp(args_size));
+	jit.mov(esp(0x4), eax);
+	jit.mov(esp(0x8), post ? 1 : 0);
+#endif
+	jit.mov(eax, reinterpret_cast<std::uintptr_t>(mfp));
+	jit.call(eax);
+
+	jit.mov(esp, ebp);
+	jit.pop(ebp);
+}
+
+void JIT_MakeReturn(AsmJit& jit, ReturnVariable& ret) {
+	// We are running in place of the hooked function: [ebp + 4] is the caller's return address
+	jit.push(ebp);
+	jit.mov(ebp, esp);
+	jit.l_and(esp, kAlign16);
+	jit.sub(esp, 0x10);
+
+	auto cls = Classify_ReturnType(ret).value();
+
+	jit.mov(esp(0x0), 1); // Pop
+	jit.mov(eax, reinterpret_cast<std::uintptr_t>(::KHook::GetCurrentValuePtr));
+	jit.call(eax);
+	// EAX now contains the return value ptr
+	switch (cls) {
+		case RetClass::Void:
+		break;
+		case RetClass::Integer:
+		case RetClass::X87Float:
+		// Keep the raw bits, we're gonna call a function which could modify EAX / the FPU stack
+		jit.mov(eax, eax());
+		jit.mov(esp(0x8), eax);
+		break;
+		case RetClass::Memory:
+		// Fill the caller's buffer (hidden pointer at [ebp + 8])
+		jit.mov(ecx, ebp(0x8));
+		Emit_CopyDwords(jit, ecx, 0, eax, 0, ret.dhook_size, edx);
+		jit.mov(esp(0x8), ecx);
+		break;
+	}
+
+	jit.mov(eax, reinterpret_cast<std::uintptr_t>(::KHook::DestroyReturnValue));
+	jit.call(eax);
+
+	switch (cls) {
+		case RetClass::Void:
+		break;
+		case RetClass::Integer:
+		case RetClass::Memory:
+		jit.mov(eax, esp(0x8));
+		break;
+		case RetClass::X87Float:
+		Emit_Fld32(jit, esp(0x8));
+		break;
+	}
+
+	jit.mov(esp, ebp);
+	jit.pop(ebp);
+	Emit_Ret(jit, ret.callee_pop);
+}
+
+void JIT_Recall(AsmJit& jit, bool save_general_register[MAX_GENERAL_REGISTERS], bool save_float_register[MAX_FLOAT_REGISTERS], size_t stack_size, std::uintptr_t* jit_start) {
+	// void (*)(void* recall_func, std::uint8_t* saved_register), called from C++
+	jit.push(ebp);
+	jit.mov(ebp, esp);
+	// Callee-saved registers, the recall clobbers them with the saved values
+	jit.push(ebx);
+	jit.push(esi);
+	jit.push(edi);
+
+	jit.mov(edi, ebp(0x8));  // Function to call
+	jit.mov(esi, ebp(0xC));  // Saved registers
+
+	jit.l_and(esp, kAlign16);
+	auto aligned_stack = static_cast<std::int32_t>((stack_size + 15) & ~static_cast<size_t>(15));
+	// Arguments start 16-byte aligned, so ESP % 16 == 12 at the callee's entry
+	jit.sub(esp, aligned_stack);
+
+	if (stack_size != 0) {
+		if (save_general_register[STACK_REG] == false) {
+			// What the hell
+			std::abort();
+		}
+		// Copy the (possibly modified) arguments, skipping the saved return address
+		jit.mov(eax, esi(sizeof(GeneralRegister) * STACK_REG));
+		Emit_CopyDwords(jit, esp, 0, eax, sizeof(void*), stack_size, ecx);
+	}
+
+	// Figure out the return address
+	jit.mov(eax, reinterpret_cast<std::uintptr_t>(jit_start));
+	jit.mov(eax, eax());
+	jit.add(eax, INT32_MAX);
+	auto add = jit.get_outputpos();
+	jit.push(eax);
+	// Function to call
+	jit.push(edi);
+
+	// Restore the registers
+	for (size_t i = 0; i < MAX_FLOAT_REGISTERS; i++) {
+		if (!save_float_register[i]) {
+			continue;
+		}
+		Emit_MovsdLoad(jit, (AsmFloatRegCode)i, esi(static_cast<std::int32_t>(MAX_GENERAL_REGISTERS * sizeof(GeneralRegister) + i * sizeof(FloatRegister))));
+	}
+
+	// KHook saves the entry registers again when re-entered and uses them when
+	// it returns to the original caller, so restore all of them (see
+	// JIT_CallMemberFunction). Neither our stack nor our frame are restored.
+	for (size_t i = 0; i < MAX_GENERAL_REGISTERS; i++) {
+		auto reg = AsmReg((AsmRegCode)i);
+		if (reg != STACK_REG && reg != ebp && reg != esi) {
+			jit.mov(reg, esi(sizeof(GeneralRegister) * i));
+		}
+	}
+	// ESI is restored last
+	jit.mov(esi, esi(sizeof(GeneralRegister) * ESI));
+
+	// Call the recall
+	jit.retn();
+	// Rewrite the add value
+	jit.rewrite<std::int32_t>(add - sizeof(std::int32_t), jit.get_outputpos());
+
+	jit.lea(esp, ebp(-0xC));
+	jit.pop(edi);
+	jit.pop(esi);
+	jit.pop(ebx);
+	jit.pop(ebp);
+	jit.retn();
+}
+
+void JIT_CallOriginal(AsmJit& jit, ReturnVariable& ret, std::uintptr_t* original_function, size_t stack_size, std::uintptr_t* jit_start) {
+	// [ebp + 4] is the return address back into KHook, arguments follow
+	jit.push(ebp);
+	jit.mov(ebp, esp);
+	jit.push(eax); // [ebp - 4], parameters may live in EAX
+
+	jit.l_and(esp, kAlign16);
+	auto aligned_stack = static_cast<std::int32_t>((stack_size + 15) & ~static_cast<size_t>(15));
+	// Arguments start 16-byte aligned, so ESP % 16 == 12 at the callee's entry
+	jit.sub(esp, aligned_stack);
+
+	// Now copy stack over
+	Emit_CopyDwords(jit, esp, 0, ebp, 0x8, stack_size, eax);
+
+	// Setup the return address to later in this function
+	jit.mov(eax, reinterpret_cast<std::uintptr_t>(jit_start));
+	jit.mov(eax, eax());
+	jit.add(eax, INT32_MAX);
+	auto add = jit.get_outputpos();
+
+	// Place the return address
+	jit.push(eax);
+
+	jit.mov(eax, reinterpret_cast<std::uintptr_t>(original_function));
+	jit.mov(eax, eax());
+
+	// Place the call address
+	jit.push(eax);
+	// Restore EAX
+	jit.mov(eax, ebp(-0x4));
+	jit.retn();
+
+	jit.rewrite<std::int32_t>(add - sizeof(std::int32_t), jit.get_outputpos());
+
+	auto cls = Classify_ReturnType(ret).value();
+
+	// The callee may have popped its arguments, rebuild an aligned frame
+	jit.lea(esp, ebp(-0x4));
+	jit.l_and(esp, kAlign16);
+	// 6 arguments + space to hold the return value
+	jit.sub(esp, 0x20);
+
+	std::uintptr_t init_op = 0;
+	std::uintptr_t deinit_op = 0;
+	std::size_t return_size = 0;
+	switch (cls) {
+		case RetClass::Void:
+		break;
+		case RetClass::Integer:
+		// Store EAX
+		jit.mov(esp(0x18), eax);
+		jit.lea(eax, esp(0x18));
+		init_op = reinterpret_cast<std::uintptr_t>(KHook::init_operator<std::uintptr_t>);
+		deinit_op = reinterpret_cast<std::uintptr_t>(KHook::deinit_operator<std::uintptr_t>);
+		return_size = sizeof(std::uintptr_t);
+		break;
+		case RetClass::X87Float:
+		// Pop ST(0), the FPU stack must be empty across calls
+		Emit_Fstp32(jit, esp(0x18));
+		jit.lea(eax, esp(0x18));
+		init_op = reinterpret_cast<std::uintptr_t>(KHook::init_operator<float>);
+		deinit_op = reinterpret_cast<std::uintptr_t>(KHook::deinit_operator<float>);
+		return_size = sizeof(float);
+		break;
+		case RetClass::Memory:
+		// EAX holds the hidden pointer the callee filled
+		if (ret.dhook_type == sp::ReturnType_Vector) {
+			init_op = reinterpret_cast<std::uintptr_t>(KHook::init_operator<sdk::Vector>);
+			deinit_op = reinterpret_cast<std::uintptr_t>(KHook::deinit_operator<sdk::Vector>);
+			return_size = sizeof(sdk::Vector);
+		} else {
+			init_op = reinterpret_cast<std::uintptr_t>(KHook::init_operator<sdk::string_t>);
+			deinit_op = reinterpret_cast<std::uintptr_t>(KHook::deinit_operator<sdk::string_t>);
+			return_size = sizeof(sdk::string_t);
+		}
+		break;
+	}
+
+	// KHook::SaveReturnValue(KHook::Action action, void* ptr_to_return, std::size_t return_size, void* init_op, void* delete_op, bool original)
+	jit.mov(esp(0x0), (std::int32_t)KHook::Action::Ignore);
+	if (cls == RetClass::Void) {
+		jit.mov(esp(0x4), 0x0);
+	} else {
+		jit.mov(esp(0x4), eax);
+	}
+	jit.mov(esp(0x8), static_cast<std::int32_t>(return_size));
+	jit.mov(esp(0xC), static_cast<std::int32_t>(init_op));
+	jit.mov(esp(0x10), static_cast<std::int32_t>(deinit_op));
+	jit.mov(esp(0x14), 1); // original
+
+	jit.mov(eax, reinterpret_cast<std::uintptr_t>(::KHook::SaveReturnValue));
+	jit.call(eax);
+
+	jit.mov(esp, ebp);
+	jit.pop(ebp);
+	jit.retn();
+}
+
+}
