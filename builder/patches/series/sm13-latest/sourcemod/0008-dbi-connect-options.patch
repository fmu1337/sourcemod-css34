 #define DBPARSE_LEVEL_MAIN		1
 #define DBPARSE_LEVEL_DATABASE	2
 
+DBConnectOptions &g_DBConnectOptions = *new DBConnectOptions();
+
+static bool DBOptionKeyEquals(const std::string &a, const char *b)
+{
+	size_t i = 0;
+	for (; i < a.size() && b[i] != '\0'; i++)
+	{
+		unsigned char x = (unsigned char)a[i], y = (unsigned char)b[i];
+		if (x >= 'A' && x <= 'Z')
+			x = x - 'A' + 'a';
+		if (y >= 'A' && y <= 'Z')
+			y = y - 'A' + 'a';
+		if (x != y)
+			return false;
+	}
+	return i == a.size() && b[i] == '\0';
+}
+
+bool DBConnectOptions::GetConnectOption(const DatabaseInfo *info, const char *key, char *buffer, size_t maxlength)
+{
+	if (buffer && maxlength)
+		buffer[0] = '\0';
+	if (!info || !key)
+		return false;
+
+	std::lock_guard<std::mutex> lock(m_Lock);
+	auto iter = m_Options.find(info);
+	if (iter == m_Options.end())
+		return false;
+	const DBConnectOptionList &options = *iter->second;
+	for (size_t i = options.size(); i > 0; i--)
+	{
+		if (!DBOptionKeyEquals(options[i - 1].first, key))
+			continue;
+		if (buffer && maxlength)
+			ke::SafeStrcpy(buffer, maxlength, options[i - 1].second.c_str());
+		return true;
+	}
+	return false;
+}
+
+void DBConnectOptions::Add(const DatabaseInfo *info, const DBConnectOptionList *options)
+{
+	std::lock_guard<std::mutex> lock(m_Lock);
+	m_Options[info] = options;
+}
+
+void DBConnectOptions::Remove(const DatabaseInfo *info)
+{
+	std::lock_guard<std::mutex> lock(m_Lock);
+	m_Options.erase(info);
+}
