 #include <am-string.h>
 #include <am-refcounting.h>
 #include <am-refcounting-threadsafe.h>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+/* css34: every key of one configuration, in file order. */
+typedef std::vector<std::pair<std::string, std::string>> DBConnectOptionList;
+
+/* css34: IDBConnectOptions. Maps the DatabaseInfo a driver receives to the
+ * keys of the configuration it was built from. Entries are added when a
+ * databases.cfg entry is complete and removed when the entry is destroyed
+ * (it is refcounted, so a pending threaded connect keeps it); SQL_ConnectCustom
+ * adds its KeyValues for the duration of the driver's Connect() call. */
+class DBConnectOptions : public IDBConnectOptions
+{
+public:
+	bool GetConnectOption(const DatabaseInfo *info, const char *key, char *buffer, size_t maxlength) override;
+	void Add(const DatabaseInfo *info, const DBConnectOptionList *options);
+	void Remove(const DatabaseInfo *info);
+private:
+	std::mutex m_Lock;
+	std::unordered_map<const DatabaseInfo *, const DBConnectOptionList *> m_Options;
+};
+
+/* Never destroyed: ConfDbInfo objects owned by other globals unregister from it
+ * during static destruction, in an order C++ does not define across files. */
+extern DBConnectOptions &g_DBConnectOptions;
+
+/* css34: registers a list for one scope (SQL_ConnectCustom). */
+class DBConnectOptionsScope
+{
+public:
+	DBConnectOptionsScope(const DatabaseInfo *info, const DBConnectOptionList *options)
+		: m_Info(info)
+	{
+		g_DBConnectOptions.Add(m_Info, options);
+	}
+	~DBConnectOptionsScope()
+	{
+		g_DBConnectOptions.Remove(m_Info);
+	}
+private:
+	const DatabaseInfo *m_Info;
+};
 
