+#ifndef _INCLUDE_SOURCEMOD_INTERFACE_DBCONNECTOPTIONS_H_
+#define _INCLUDE_SOURCEMOD_INTERFACE_DBCONNECTOPTIONS_H_
+
+#include <IShareSys.h>
+#include <IDBDriver.h>
+#include <stddef.h>
+
+/**
+ * @file IDBConnectOptions.h
+ * @brief css34: driver-specific keys of a database configuration.
+ *
+ * DatabaseInfo only carries the keys every driver shares (driver, host,
+ * database, user, pass, port, timeout, schema), and its layout is part of the
+ * DBI ABI. Core keeps every key of a databases.cfg entry, and of the KeyValues
+ * passed to SQL_ConnectCustom, and serves them through this separate interface,
+ * so a driver can read its own keys (for example the MySQL driver's ssl_mode
+ * and ssl_ca) without any change to IDBDriver.h. Drivers that never ask are
+ * unaffected; a driver loaded by a core without this interface simply fails to
+ * request it.
+ */
+
+#define SMINTERFACE_DBCONNECTOPTIONS_NAME		"IDBConnectOptions"
+#define SMINTERFACE_DBCONNECTOPTIONS_VERSION	1
+
+namespace SourceMod
+{
+	class IDBConnectOptions : public SMInterface
+	{
+	public:
+		const char *GetInterfaceName()
+		{
+			return SMINTERFACE_DBCONNECTOPTIONS_NAME;
+		}
+		unsigned int GetInterfaceVersion()
+		{
+			return SMINTERFACE_DBCONNECTOPTIONS_VERSION;
+		}
+	public:
+		/**
+		 * @brief Reads one key of the configuration a DatabaseInfo came from.
+		 *
+		 * Known origins: a databases.cfg entry (SQL_Connect, SQL_TConnect,
+		 * Database.Connect, IDBManager::Connect and FindDatabaseConf, also
+		 * from the database worker thread) and, for the duration of the
+		 * driver's Connect() call, the KeyValues of SQL_ConnectCustom.
+		 * A DatabaseInfo built any other way (SQL_ConnectEx, an extension's
+		 * own struct) has no keys. Thread-safe.
+		 *
+		 * @param info			The pointer the driver's Connect() received.
+		 * @param key			Key name (ASCII case-insensitive; the last
+		 *						occurrence of a repeated key wins).
+		 * @param buffer		Receives the value (may be empty), truncated
+		 *						and always NUL-terminated.
+		 * @param maxlength		Size of buffer.
+		 * @return				True if the configuration has the key.
+		 */
+		virtual bool GetConnectOption(const DatabaseInfo *info,
+			const char *key,
+			char *buffer,
+			size_t maxlength) =0;
+	};
+}
+
+#endif //_INCLUDE_SOURCEMOD_INTERFACE_DBCONNECTOPTIONS_H_
