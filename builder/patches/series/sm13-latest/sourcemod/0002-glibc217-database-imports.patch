diff --git a/extensions/pgsql/AMBuilder b/extensions/pgsql/AMBuilder
index f1c816f5c4e4d6faf762399ac51608d299e21984..9d29c4053f94beae8d3f5fd191b0ea08c797ea26 100644
--- a/extensions/pgsql/AMBuilder
