   SM.extensions += [builder.Add(binary)]
diff --git a/extensions/pgsql/css34_explicit_bzero.c b/extensions/pgsql/css34_explicit_bzero.c
new file mode 100644
index 0000000000000000000000000000000000000000..f8e7375d2a046ebb15d5d460ed2516dc3a66c00f
--- /dev/null
+++ b/extensions/pgsql/css34_explicit_bzero.c
@@ -0,0 +1,13 @@
+/* Temporary until libpq is built from source in manylinux2014.
+ * PostgreSQL provides src/port/explicit_bzero.c for that build.
+ * Hidden: never interpose on the host libc or another extension.
+ */
+#include <string.h>
+
+__attribute__((visibility("hidden")))
+void explicit_bzero(void *buf, size_t len)
+{
+    memset(buf, 0, len);
+    /* Prevent dead-store elimination of password erasure. */
+    __asm__ __volatile__("" : : "r"(buf) : "memory");
+}
