@@ -57,4 +57,7 @@ for cxx in builder.targets:
     os.path.join('pgsql', 'PgStatement.cpp'),
     'extension.cpp'
   ]
+  # css34: temporary glibc 2.17 explicit_bzero for vendored libpq.
+  if compiler.target.platform == 'linux':
