+ * FOR A PARTICULAR PURPOSE.  See the GNU General Public License for more
+ * details.
+ *
+ * You should have received a copy of the GNU General Public License along with
+ * this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "MySslOptions.h"
+#include <stdio.h>
+#include <string.h>
+
+static const struct
+{
+	const char *name;
+	MySslMode mode;
+} s_Modes[] =
+{
+	{"disabled", MySsl_Disabled},
+	{"preferred", MySsl_Preferred},
+	{"required", MySsl_Required},
+	{"verify_ca", MySsl_VerifyCA},
+	{"verify_identity", MySsl_VerifyIdentity},
+};
+
+static bool EqualsNoCase(const char *a, const char *b)
+{
+	for (;; a++, b++)
+	{
+		unsigned char x = (unsigned char)*a, y = (unsigned char)*b;
+		if (x >= 'A' && x <= 'Z')
+			x = x - 'A' + 'a';
+		if (y >= 'A' && y <= 'Z')
+			y = y - 'A' + 'a';
+		if (x != y)
+			return false;
+		if (!x)
+			return true;
+	}
+}
+
+bool MySsl_ParseMode(const char *value, MySslMode *mode)
+{
+	if (!value || !value[0])
+	{
+		*mode = MySsl_Preferred;
+		return true;
+	}
+	for (size_t i = 0; i < sizeof(s_Modes) / sizeof(s_Modes[0]); i++)
+	{
+		if (EqualsNoCase(value, s_Modes[i].name))
+		{
+			*mode = s_Modes[i].mode;
+			return true;
+		}
+	}
+	return false;
+}
+
+const char *MySsl_ModeName(MySslMode mode)
+{
+	for (size_t i = 0; i < sizeof(s_Modes) / sizeof(s_Modes[0]); i++)
+	{
+		if (s_Modes[i].mode == mode)
+			return s_Modes[i].name;
+	}
+	return "?";
+}
+
+static bool IsAbsolutePath(const char *path)
+{
+	if (path[0] == '/' || path[0] == '\\')
+		return true;
+	/* C:\... or C:/... */
+	return ((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z'))
+		&& path[1] == ':';
+}
+
+bool MySsl_Resolve(const char *mode,
+	const char *ca,
+	const char *sm_path,
+	MySslSettings *out,
+	char *error,
+	size_t maxlength)
+{
+	out->mode = MySsl_Preferred;
+	out->ca[0] = '\0';
+
+	if (!MySsl_ParseMode(mode, &out->mode))
+	{
+		snprintf(error, maxlength,
+			"ssl_mode \"%s\" is not one of disabled, preferred, required, verify_ca, verify_identity",
+			mode);
+		return false;
+	}
+	if (out->mode != MySsl_VerifyCA && out->mode != MySsl_VerifyIdentity)
+	{
+		/* Like sm-dbi-mysql: only the verify modes read ssl_ca. */
+		return true;
+	}
+
+	if (!ca || !ca[0])
+	{
+		snprintf(error, maxlength,
+			"ssl_mode %s needs ssl_ca (the server's CA certificate, PEM, relative to addons/sourcemod/)",
+			MySsl_ModeName(out->mode));
+		return false;
+	}
+
+	int written;
+	if (IsAbsolutePath(ca) || !sm_path || !sm_path[0])
+		written = snprintf(out->ca, sizeof(out->ca), "%s", ca);
+	else
+		written = snprintf(out->ca, sizeof(out->ca), "%s/%s", sm_path, ca);
+	if (written < 0 || (size_t)written >= sizeof(out->ca))
+	{
+		snprintf(error, maxlength, "ssl_ca path too long: \"%s\"", ca);
+		out->ca[0] = '\0';
+		return false;
+	}
+
+	FILE *fp = fopen(out->ca, "rb");
+	if (!fp)
+	{
+		snprintf(error, maxlength, "ssl_mode %s: cannot read ssl_ca \"%s\"",
+			MySsl_ModeName(out->mode), out->ca);
+		return false;
+	}
+	fclose(fp);
+	return true;
+}
