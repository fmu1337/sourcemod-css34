+ * this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef _INCLUDE_SM_MYSQL_SSL_OPTIONS_H_
+#define _INCLUDE_SM_MYSQL_SSL_OPTIONS_H_
+
+#include <stddef.h>
+
+/**
+ * css34: the ssl_mode / ssl_ca keys of a database configuration. Same names,
+ * values and default as fmu1337/sm-dbi-mysql, so a databases.cfg written for
+ * that driver keeps working:
+ *
+ *   ssl_mode  disabled | preferred (default) | required | verify_ca | verify_identity
+ *             (ASCII case-insensitive; an empty value is the default)
+ *   ssl_ca    CA certificate file (PEM), relative to addons/sourcemod/ unless
+ *             absolute; read by verify_ca and verify_identity only
+ *
+ * Pure parsing and validation, without SourceMod or the MySQL client, so
+ * testing/scripts/test-mysql-ssl-options.py can compile it on its own.
+ */
+
+enum MySslMode
+{
+	MySsl_Disabled = 0,		/**< no TLS (SourceMod 1.13's own behaviour) */
+	MySsl_Preferred,		/**< TLS when the server offers it, certificate not checked */
+	MySsl_Required,			/**< TLS or no connection, certificate not checked */
+	MySsl_VerifyCA,			/**< TLS, certificate chain checked against ssl_ca */
+	MySsl_VerifyIdentity	/**< as verify_ca, and the host name must match the certificate */
+};
+
+#define MYSSL_MAX_PATH	1024
+
+struct MySslSettings
+{
+	MySslMode mode;
+	char ca[MYSSL_MAX_PATH];	/**< resolved ssl_ca, "" unless a verify mode */
+};
+
+/** NULL or "" is the default (preferred). False for any other unknown value. */
+bool MySsl_ParseMode(const char *value, MySslMode *mode);
+
+/** Canonical lower-case name of a mode. */
+const char *MySsl_ModeName(MySslMode mode);
+
+/**
+ * Settings from the raw keys (NULL when a key is absent). sm_path is the
+ * absolute addons/sourcemod path that a relative ssl_ca is joined to.
+ *
+ * Fails, with a message for the plugin, on an unknown ssl_mode, a verify mode
+ * without ssl_ca, or an ssl_ca file that cannot be opened. Never downgrades.
+ */
+bool MySsl_Resolve(const char *mode,
+	const char *ca,
+	const char *sm_path,
+	MySslSettings *out,
+	char *error,
+	size_t maxlength);
+
+#endif //_INCLUDE_SM_MYSQL_SSL_OPTIONS_H_
