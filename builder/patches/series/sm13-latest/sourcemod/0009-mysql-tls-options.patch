index 0000000000000000000000000000000000000000..74d95e62a2d8f192db6da701a51a959f37a96645
--- /dev/null
+++ b/extensions/mysql/mysql/MySslOptions.cpp
@@ -0,0 +1,142 @@
+/**
+ * vim: set ts=4 sw=4 tw=99 noet :
+ * =============================================================================
+ * SourceMod MySQL Extension (CS:S v34 build)
+ * =============================================================================
+ *
