+ * verification on, a server without TLS is refused before authentication, and
+ * the verification callback decides what is checked: the library's own one
+ * (chain against ssl_ca and host name) for verify_identity, the same without
+ * the host name for verify_ca, and none for required.
+ */
+extern "C" int ma_pvio_tls_verify_server_cert(void *ctls, unsigned int flags);
+
+static int MySsl_VerifyChainOnly(void *ctls, unsigned int flags)
+{
+	return ma_pvio_tls_verify_server_cert(ctls, flags & ~MARIADB_TLS_VERIFY_HOST);
+}
+
+#if !defined(_WIN32)
+#if MARIADB_PACKAGE_VERSION_ID != 30409
+#error "css34: re-check MySsl_TlsHead against this MariaDB Connector/C's ma_tls.h (MARIADB_TLS)"
+#endif
+/* The leading members of MARIADB_TLS (ma_tls.h, which needs the uninstalled
+ * ma_hash.h). */
+struct MySsl_TlsHead
+{
+	void *data;
+	MARIADB_PVIO *pvio;
+};
+#endif
+
+static int MySsl_AcceptUnverified(void *ctls, unsigned int flags)
+{
+#if !defined(_WIN32)
+	/* OpenSSL records chain problems during the handshake; the connector fails
+	 * the login later unless they are cleared. "required" checks no chain. */
+	MySsl_TlsHead *tls = (MySsl_TlsHead *)ctls;
+	if (!tls || !tls->pvio || tls->pvio->ctls != ctls || !tls->pvio->mysql)
+		return 1;
+	tls->pvio->mysql->net.tls_verify_status = 0;
+#endif
+	return 0;
+}
+
+static void MySsl_Apply(MYSQL *mysql, const MySslSettings &ssl)
+{
+	my_bool enforce = (ssl.mode != MySsl_Disabled);
+	my_bool verify = (ssl.mode >= MySsl_Required);
+
+	/* MariaDB Connector/C 3.3.10 and newer verify by default, which needs TLS;
+	 * disabled and preferred keep SourceMod's setting (verification off). */
+	mysql_options(mysql, MYSQL_OPT_SSL_VERIFY_SERVER_CERT, (const char *)&verify);
+	if (!enforce)
+		return;
+
+	mysql_options(mysql, MYSQL_OPT_SSL_ENFORCE, (const char *)&enforce);
+#if !defined(_WIN32)
+	/* OpenSSL: MySQL 8.4 / HeatWave speak TLS 1.2 and 1.3 only. Schannel keeps
+	 * the system's protocol set (TLS 1.3 needs Windows 11 / Server 2022). */
+	mysql_options(mysql, MARIADB_OPT_TLS_VERSION, "TLSv1.2,TLSv1.3");
+#endif
+	switch (ssl.mode)
+	{
+	case MySsl_Required:
+		mysql_options(mysql, MARIADB_OPT_TLS_VERIFICATION_CALLBACK, (const void *)MySsl_AcceptUnverified);
+		break;
+	case MySsl_VerifyCA:
+		mysql_options(mysql, MYSQL_OPT_SSL_CA, ssl.ca);
+		mysql_options(mysql, MARIADB_OPT_TLS_VERIFICATION_CALLBACK, (const void *)MySsl_VerifyChainOnly);
+		break;
+	case MySsl_VerifyIdentity:
+		mysql_options(mysql, MYSQL_OPT_SSL_CA, ssl.ca);
+		break;
+	default:
+		break;
+	}
+}
