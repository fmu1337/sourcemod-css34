+#if defined PLATFORM_LINUX
+struct MappedGameBinarySearch
+{
+	char names[3][64];
+	char *path;
+	size_t maxlength;
+	void *addr;
+};
+
+static int FindMappedGameBinaryCallback(struct dl_phdr_info *phdr, size_t size, void *data)
+{
+	MappedGameBinarySearch *search = (MappedGameBinarySearch *)data;
+	const char *base = strrchr(phdr->dlpi_name, '/');
+	base = base ? base + 1 : phdr->dlpi_name;
+	for (size_t i = 0; i < sizeof(search->names) / sizeof(search->names[0]); i++)
+	{
+		if (search->names[i][0] == '\0' || strcmp(base, search->names[i]) != 0)
+			continue;
+		/* Start of the first PT_LOAD segment: an address dladdr maps back
+		 * to this module. */
+		for (ElfW(Half) j = 0; j < phdr->dlpi_phnum; j++)
+		{
+			if (phdr->dlpi_phdr[j].p_type == PT_LOAD)
+			{
+				search->addr = (void *)(phdr->dlpi_addr + phdr->dlpi_phdr[j].p_vaddr);
+				ke::SafeStrcpy(search->path, search->maxlength, phdr->dlpi_name);
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
+
+/* css34: path of, and an address inside, the mapped module named name; for
+ * name_i486.so also name_i686.so / name_amd.so (the engine srcds -binary
+ * picked). nullptr if none is mapped. */
+static void *FindMappedGameBinary(const char *name, char *path, size_t maxlength)
+{
+	MappedGameBinarySearch search;
+	memset(&search, 0, sizeof(search));
+	search.path = path;
+	search.maxlength = maxlength;
+	ke::SafeStrcpy(search.names[0], sizeof(search.names[0]), name);
+
+	size_t len = strlen(name);
+	static const char kSuffix[] = "_i486.so";
+	if (len > sizeof(kSuffix) - 1 && strcmp(name + len - (sizeof(kSuffix) - 1), kSuffix) == 0)
+	{
+		int stem = (int)(len - (sizeof(kSuffix) - 1));
+		ke::SafeSprintf(search.names[1], sizeof(search.names[1]), "%.*s_i686.so", stem, name);
+		ke::SafeSprintf(search.names[2], sizeof(search.names[2]), "%.*s_amd.so", stem, name);
+	}
+
+	dl_iterate_phdr(FindMappedGameBinaryCallback, &search);
+	return search.addr;
+}
+#endif
