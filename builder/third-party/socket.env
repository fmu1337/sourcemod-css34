# shellcheck shell=bash
# Pins of the third-party Socket extension (JoinedSenses/sm-ext-socket, legacy
# natives SocketCreate/SocketConnect/... plus the Socket methodmap, "Socket (3.0.2)").
# Sourced by builder/run/linux.sh, builder/third-party/socket.sh,
# testing/scripts/check-third-party.sh and .github/workflows/ci.yml (smoke).
# See docs/EXTENSIONS.md "Third-party extensions".

# Lines whose Linux SourceMod package bundles it (one binary per line:
# docs/EXTENSIONS.md); check-third-party.sh requires it in their packages.
SOCKET_LINES="sm13-latest"

SOCKET_VERSION="3.0.2"
SOCKET_REPO="https://github.com/JoinedSenses/sm-ext-socket"
SOCKET_COMMIT="f699399524dd0c0f4710400b38dda0f0f9e7d5d8"
# sha256 over the commit's tracked files, independent of git and tar versions:
#   git ls-files -z | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum
SOCKET_TREE_SHA256="22cd7a708235141715f826c92a49b649a4276b1d9a2f309b440c646e1a8f54be"

# Header-only asio (boost::asio, boost::bind, boost::system); nothing of boost is
# compiled or linked. Fetched with fetch_pinned.
SOCKET_BOOST_VERSION="1.83.0"
SOCKET_BOOST_URL="https://archives.boost.io/release/1.83.0/source/boost_1_83_0.tar.bz2"
SOCKET_BOOST_SHA256="6478edfe2f3305127cffe8caf73ea0176c53769f4bf1585be237eb30798c3b8e"

