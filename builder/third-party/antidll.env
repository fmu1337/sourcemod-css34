# shellcheck shell=bash
# Pins of the third-party AntiDLL extension + handler plugin (JDW1337/AntiDLL:
# CDetour on CBaseClient::ProcessListenEvents, forward AD_OnCheatDetected).
# Sourced by builder/run/linux.sh and builder/third-party/antidll.sh.
# See docs/EXTENSIONS.md "AntiDLL".
#
# Not bundled in the SourceMod package (an anticheat with its own configs is an
# opt-in install): antidll.sh writes two standalone archives to packages/antidll/,
#   antidll-<ver>-sm13-css34-linux.tar.gz  AntiDLL.ext.2.ep1.so (this line's SM,
#                                          extension API of the line) + smx (line spcomp)
#   antidll-<ver>-sm17-css34-linux.tar.gz  AntiDLL.ext.1.ep1.so against the SM 1.7
#                                          SDK (API 8, ISourceMod 13) + smx (spcomp 1.7.3)
# for servers still on SourceMod 1.7.3 (1.ep1 core under Metamod 1.10 "core-legacy").

# Lines whose build also produces the AntiDLL archives (both variants).
ANTIDLL_LINES="sm13-latest"

ANTIDLL_VERSION="1.4.1"
ANTIDLL_REPO="https://github.com/JDW1337/AntiDLL"
ANTIDLL_COMMIT="eb6a7831eef63502d62a193a704f9a30e30517b6"
# sha256 over the commit's tracked files (LF checkout), independent of git and tar:
#   git ls-files -z | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum
ANTIDLL_TREE_SHA256="1c22f00b5d3addceb2349186dcb81b9331379e9d2da80f12105f6d6825c1542f"

# SourceMod 1.7 SDK (public/ headers, CDetour + asm) for the 1.7 variant:
# the 1.7-dev tip, the source of the last 1.7.3 builds.
ANTIDLL_SM17_REPO="https://github.com/alliedmodders/sourcemod"
ANTIDLL_SM17_COMMIT="09045f48978152381408c5f118e4895d2177604a"
# spcomp 1.7.3 (plugins built by spcomp 1.11+ fail on 1.7 with "Plugin format is too new").
ANTIDLL_SM17_PKG_URL="https://sm.alliedmods.net/smdrop/1.7/sourcemod-1.7.3-git5334-linux.tar.gz"
ANTIDLL_SM17_PKG_SHA256="1b661b251f716e745dd1c0b73717a4d7e384161d677d5d4c4d19efbbde0cf65f"
# Metamod:Source 1.10 (core-legacy headers for the 1.ep1 core); versions.env MM_110_*.
