#!/usr/bin/expect -f
# Boot srcds, spawn bots, record console output for RECORD_SECS, then quit.
set timeout [expr {
  [info exists env(RECORD_SECS)] && $env(RECORD_SECS) ne "" ? $env(RECORD_SECS) + 120 : 720
}]

if {![info exists env(BOTPLAY_LOG)]} {
    puts stderr "BOTPLAY_LOG is required"
    exit 1
}
log_file -noappend $env(BOTPLAY_LOG)

if {[info exists env(SERVER_DIR)] && $env(SERVER_DIR) ne ""} {
    set server_dir $env(SERVER_DIR)
} else {
    set server_dir "/workspace/.ci-server"
}
if {[info exists env(MAP)] && $env(MAP) ne ""} {
    set map $env(MAP)
} else {
    set map "de_dust2"
}
if {[info exists env(PORT)] && $env(PORT) ne ""} {
    set port $env(PORT)
} else {
    set port "27015"
}
if {[info exists env(SRCDS_BINARY)] && $env(SRCDS_BINARY) ne ""} {
    set binary $env(SRCDS_BINARY)
} else {
    set binary "./srcds_i686"
}
if {[info exists env(BOTPLAY_CFG)] && $env(BOTPLAY_CFG) ne ""} {
    set botplay_cfg $env(BOTPLAY_CFG)
} else {
    set botplay_cfg "botplay-stress.cfg"
}
if {[info exists env(RECORD_SECS)] && $env(RECORD_SECS) ne ""} {
    set record_secs $env(RECORD_SECS)
} else {
    set record_secs 600
}

cd $server_dir
set env(LD_LIBRARY_PATH) ".:bin:$env(LD_LIBRARY_PATH)"

if {[info exists env(SMOKE_VERBOSE)] && $env(SMOKE_VERBOSE) ne "" && $env(SMOKE_VERBOSE) ne "0"} {
    log_user 1
} else {
    log_user 0
}

set spawn_args [list $binary -game cstrike -console -nohltv \
    -nomaster -localcser -tickrate 66 \
    -ip 127.0.0.1 -port $port +ip 127.0.0.1 +sv_lan 1 +maxplayers 16 +map $map]
if {[info exists env(SMOKE_CONDEBUG)] && $env(SMOKE_CONDEBUG) ne "" && $env(SMOKE_CONDEBUG) ne "0"} {
    lappend spawn_args -condebug
}
if {[info exists env(SMOKE_VERBOSE)] && $env(SMOKE_VERBOSE) ne "" && $env(SMOKE_VERBOSE) ne "0"} {
    lappend spawn_args +log on +sv_logfile 1
}
eval spawn $spawn_args

expect {
    -re "Mapchange to ${map}|Loading map \"${map}\"" {
        puts stderr "OK: matched map load (${map})"
    }
    eof {
        puts stderr "srcds exited before map $map loaded"
        exit 1
    }
    timeout {
        puts stderr "timeout waiting for map $map"
        exit 1
    }
}

# Let MM/SM finish loading before botplay cfg.
sleep 5

send "status\r"
expect {
    -re {hostname|# [0-9]+} {}
    eof { puts stderr "srcds exited during status"; exit 2 }
    timeout { puts stderr "timeout waiting for status"; exit 2 }
}

send "meta version\r"
expect {
    -re {Metamod|metamod|MM:S} {}
    eof { puts stderr "srcds exited during meta version"; exit 3 }
    timeout { puts stderr "timeout waiting for meta version"; exit 3 }
}

send "sm version\r"
expect {
    -re {SourceMod Version|SourceMod} {}
    eof { puts stderr "srcds exited during sm version"; exit 4 }
    timeout { puts stderr "timeout waiting for sm version"; exit 4 }
}

# Force-load SDK Hooks so botplay can assert css34 OnTakeDamage gamedata path.
send "sm exts load sdkhooks\r"
expect {
    -re {SDK Hooks|sdkhooks|Failed|error|Error|already} {}
    eof { puts stderr "srcds exited while loading sdkhooks"; exit 9 }
    timeout { puts stderr "timeout waiting for sdkhooks load"; exit 9 }
}
sleep 1

send "sm exts list\r"
expect {
    -re {\[SM\] Displaying [0-9]+ extensions:|\[SM\] No extensions are loaded\.} {}
    eof { puts stderr "srcds exited during sm exts list"; exit 5 }
    timeout { puts stderr "timeout waiting for sm exts list"; exit 5 }
}

sleep 1
send "sm plugins list\r"
expect {
    -re {\[SM\] Listing [0-9]+ plugins:} {}
    -re {\[SM\] No plugins loaded} {}
    eof { puts stderr "srcds exited during sm plugins list"; exit 6 }
    timeout { puts stderr "timeout waiting for sm plugins list"; exit 6 }
}

sleep 1

# Apply botplay settings (cfg is copied into cstrike/cfg by botplay-test.sh).
send "exec ${botplay_cfg}\r"
sleep 8

send "mp_restartgame 1\r"
sleep 5

# API probe is triggered by css34_botplay_stress after ABI checks pass (bots + extensions ready).
puts stderr "Recording botplay session for ${record_secs}s..."
set end_at [expr {[clock seconds] + $record_secs}]
while {[clock seconds] < $end_at} {
    set remaining [expr {$end_at - [clock seconds]}]
    if {$remaining < 1} { set remaining 1 }
    if {$remaining > 30} { set remaining 30 }
    expect {
        eof {
            puts stderr "srcds exited during botplay recording"
            exit 8
        }
        timeout {}
    }
}

# DHOOKS_UNLOAD_TEST=1: unload the DHooks probe and dhooks.ext on the live
# server, then keep playing through bot removal and a level change (entity
# destructors, LevelShutdown) with no DHooks hook left behind.
if {[info exists env(DHOOKS_UNLOAD_TEST)] && $env(DHOOKS_UNLOAD_TEST) eq "1"} {
    set timeout 10
    send "sm plugins unload css34_dhooks_probe\r"
    sleep 2
    send "sm exts list\r"
    set dh_index ""
    expect {
        -re {\[([0-9]+)\] DHooks \(} { set dh_index $expect_out(1,string) }
        eof { puts stderr "srcds exited before dhooks unload"; exit 10 }
        timeout {}
    }
    if {$dh_index eq ""} {
        puts stderr "DHooks is not loaded, cannot run the unload test"
        exit 10
    }
    sleep 1
    send "sm exts unload $dh_index\r"
    expect {
        -re {is now unloaded} {}
        eof { puts stderr "srcds exited while unloading dhooks"; exit 10 }
        timeout { puts stderr "timeout unloading dhooks"; exit 10 }
    }
    puts stderr "dhooks.ext unloaded (index $dh_index), playing on"
    set end_at [expr {[clock seconds] + 20}]
    while {[clock seconds] < $end_at} {
        expect {
            eof { puts stderr "srcds exited after dhooks unload"; exit 10 }
            timeout {}
        }
    }
    send "bot_kick\r"
    sleep 3
    send "changelevel ${map}\r"
    set end_at [expr {[clock seconds] + 25}]
    while {[clock seconds] < $end_at} {
        expect {
            eof { puts stderr "srcds exited during changelevel after dhooks unload"; exit 10 }
            timeout {}
        }
    }
    send "sm exts load dhooks\r"
    expect {
        -re {Loaded extension dhooks} {}
        eof { puts stderr "srcds exited while reloading dhooks"; exit 10 }
        timeout { puts stderr "timeout reloading dhooks"; exit 10 }
    }
    puts stderr "OK: DHooks unload / reload on a live server"
}

send "status\r"
expect {
    -re {hostname|# [0-9]+} {}
    eof {}
    timeout {}
}

send "quit\r"
expect {
    eof {}
    timeout {}
}

puts stderr "OK: botplay recording finished (${record_secs}s)"
exit 0
