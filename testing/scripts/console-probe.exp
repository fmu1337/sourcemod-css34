#!/usr/bin/expect -f
# Send srcds console commands after map load; log full session to CONSOLE_PROBE_LOG.
set timeout [expr {[info exists env(CONSOLE_PROBE_TIMEOUT)] ? $env(CONSOLE_PROBE_TIMEOUT) : 90}]

if {![info exists env(CONSOLE_PROBE_LOG)]} {
    puts stderr "CONSOLE_PROBE_LOG is required"
    exit 1
}
log_file -noappend $env(CONSOLE_PROBE_LOG)

# Avoid expr bareword pitfalls on older Tcl (RHEL 8 expect).
if {[info exists env(SERVER_DIR)] && $env(SERVER_DIR) ne ""} {
    set server_dir $env(SERVER_DIR)
} else {
    set server_dir "/workspace/.ci-server"
}
if {[info exists env(MAP)] && $env(MAP) ne ""} {
    set map $env(MAP)
} else {
    set map "de_dust2"
}
if {[info exists env(PORT)] && $env(PORT) ne ""} {
    set port $env(PORT)
} else {
    set port "27015"
}
if {[info exists env(SRCDS_BINARY)] && $env(SRCDS_BINARY) ne ""} {
    set binary $env(SRCDS_BINARY)
} else {
    set binary "./srcds_i686"
}

cd $server_dir
set env(LD_LIBRARY_PATH) ".:bin:$env(LD_LIBRARY_PATH)"

# Spawn the engine binary directly (not srcds_run). The shell wrapper has caused
# early EOF / opaque failures on some RHEL 8 images under expect's pty.
if {[info exists env(SMOKE_VERBOSE)] && $env(SMOKE_VERBOSE) ne "" && $env(SMOKE_VERBOSE) ne "0"} {
    log_user 1
}

set spawn_args [list $binary -game cstrike -console -nohltv \
    -nomaster -localcser -tickrate 66 \
    -ip 127.0.0.1 -port $port +ip 127.0.0.1 +sv_lan 1 +maxplayers 10 +map $map]
if {[info exists env(SMOKE_CONDEBUG)] && $env(SMOKE_CONDEBUG) ne "" && $env(SMOKE_CONDEBUG) ne "0"} {
    lappend spawn_args -condebug
}
if {[info exists env(SMOKE_VERBOSE)] && $env(SMOKE_VERBOSE) ne "" && $env(SMOKE_VERBOSE) ne "0"} {
    lappend spawn_args +log on +sv_logfile 1
}
eval spawn $spawn_args

# Match either SourceMod's mapchange log string or the engine's loading map log line
expect {
    -re "Mapchange to ${map}|Loading map \"${map}\"" {
        puts stderr "OK: matched map load (${map})"
    }
    eof {
        puts stderr "srcds exited before map $map loaded"
        exit 1
    }
    timeout {
        puts stderr "timeout waiting for map $map"
        exit 1
    }
}

# Give MM/SM a moment after map load.
sleep 3
set probe_failed 0

send "status\r"
expect {
    -re {hostname|# [0-9]+} {}
    eof {
        puts stderr "srcds exited while waiting for status output"
        exit 2
    }
    timeout {
        puts stderr "timeout waiting for status output"
        set probe_failed 1
    }
}

send "version\r"
expect {
    -re {Protocol version|Exe version|version} {}
    eof {
        puts stderr "srcds exited while waiting for version output"
        exit 3
    }
    timeout {
        puts stderr "timeout waiting for version output"
        set probe_failed 1
    }
}

# Version text is printed before Build ID. A wrong build number should fail
# quickly; map load keeps the longer CONSOLE_PROBE_TIMEOUT.
set saved_timeout $timeout
set timeout 20

send "meta version\r"
if {[info exists env(META_VERSION_NEEDLE)] && $env(META_VERSION_NEEDLE) ne ""} {
    set meta_ver $env(META_VERSION_NEEDLE)
} else {
    set meta_ver "Metamod:Source version"
}
expect {
    -ex $meta_ver {}
    eof {
        puts stderr "srcds exited while waiting for meta version output ($meta_ver)"
        exit 4
    }
    timeout {
        puts stderr "timeout waiting for meta version output ($meta_ver)"
        set probe_failed 1
    }
}
if {[info exists env(META_BUILD_ID_NEEDLE)] && $env(META_BUILD_ID_NEEDLE) ne ""} {
    set meta_id $env(META_BUILD_ID_NEEDLE)
} else {
    set meta_id "Build ID:"
}
expect {
    -ex $meta_id {}
    eof {
        puts stderr "srcds exited while waiting for meta Build ID ($meta_id)"
        exit 4
    }
    timeout {
        puts stderr "timeout waiting for meta Build ID ($meta_id)"
        set probe_failed 1
    }
}

send "sm version\r"
if {[info exists env(SM_VERSION_NEEDLE)] && $env(SM_VERSION_NEEDLE) ne ""} {
    set sm_pat $env(SM_VERSION_NEEDLE)
} else {
    set sm_pat "SourceMod Version"
}
expect {
    -ex $sm_pat {}
    eof {
        puts stderr "srcds exited while waiting for sm version output ($sm_pat)"
        exit 5
    }
    timeout {
        puts stderr "timeout waiting for sm version output ($sm_pat)"
        set probe_failed 1
    }
}
set timeout $saved_timeout

# basecommands is part of every standard SourceMod install. This leaves the
# default value unchanged but makes its normal LogAction() path open and write
# the SourceMod session log without patching Logger.cpp.
send "sm_cvar sv_cheats 0\r"
expect {
    -re {Changed cvar "sv_cheats"} {}
    eof {
        puts stderr "srcds exited while invoking sm_cvar logging probe"
        exit 9
    }
    timeout {
        puts stderr "timeout waiting for sm_cvar logging probe"
        set probe_failed 1
    }
}

# DBI drivers are not autoloaded. A broken OpenSSL/glibc link only shows up here.
# geoip and regex are optional: smoke-test.sh records them and does not fail the run.
proc probe_ext_load {name} {
    global probe_failed
    send "sm exts load $name\r"
    expect {
        -re {successfully|already loaded|Unable to load|[Ff]ailed to load|Could not|could not|error|Error} {}
        eof {
            puts stderr "srcds exited while loading extension $name"
            exit 10
        }
        timeout {
            puts stderr "timeout waiting for extension load $name"
            set probe_failed 1
        }
    }
    sleep 1
}

probe_ext_load dbi.mysql.ext
probe_ext_load dbi.pgsql.ext
probe_ext_load geoip.ext
probe_ext_load regex.ext

# Force-load SDK Hooks so smoke can assert css34 OnTakeDamage gamedata path.
send "sm exts load sdkhooks\r"
expect {
    -re {SDK Hooks|sdkhooks|Failed|error|Error|already} {}
    eof {
        puts stderr "srcds exited while loading sdkhooks"
        exit 8
    }
    timeout {
        puts stderr "timeout waiting for sdkhooks load"
        set probe_failed 1
    }
}
sleep 1

send "sm exts list\r"
expect {
    -re {\[SM\] Displaying [0-9]+ extensions:|\[SM\] No extensions are loaded\.} {}
    eof {
        puts stderr "srcds exited while waiting for sm exts list output"
        exit 6
    }
    timeout {
        puts stderr "timeout waiting for sm exts list output"
        set probe_failed 1
    }
}

# Allow extension lines to flush before plugin list.
sleep 1

send "sm plugins list\r"
expect {
    -re {\[SM\] Listing [0-9]+ plugins:} {}
    eof {
        puts stderr "srcds exited while waiting for sm plugins list output"
        exit 7
    }
    timeout {
        puts stderr "timeout waiting for sm plugins list output"
        set probe_failed 1
    }
}

# Allow plugin lines to flush before shutdown.
sleep 1

send "quit\r"
expect {
    eof {}
    timeout {}
}

# Retain a failed result after collecting the remaining diagnostics.
exit $probe_failed
